{
  "name": "@repo/backend",
  "version": "1.0.0",
  "description": "API server for the project",
  "type": "module",
  "scripts": {
    "build": "bun build --target bun --outfile dist/server.js ./src/web/server.ts",
    "dev": "bun run --watch src/web/server.ts",
    "start": "bun src/web/server",
    "start:prod": "bun dist/server.js",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate --name",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run src/scripts/seed.ts",
    "check-types": "tsgo --noEmit --pretty",
    "lint": "biome check",
    "test": "bun test"
  },
  "keywords": [],
  "author": "",
  "devDependencies": {
    "@repo/configs": "workspace:*",
    "@scalar/openapi-types": "^0.5.2",
    "@standard-schema/spec": "^1.0.0",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "drizzle-kit": "^0.31.8",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.10",
    "@carbonteq/fp": "catalog:",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/openapi": "^1.4.11",
    "@elysiajs/opentelemetry": "^1.4.8",
    "@elysiajs/static": "^1.4.7",
    "@orpc/json-schema": "^1.12.2",
    "@orpc/openapi": "^1.12.2",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@repo/contract": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.0",
    "effect": "catalog:",
    "elysia": "^1.4.18",
    "env-var": "^7.5.0",
    "fast-jwt": "^6.1.0",
    "hono": "^4.10.7",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "catalog:",
    "zod": "catalog:"
  }
}
