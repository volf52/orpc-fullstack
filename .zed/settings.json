// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
  "colorize_brackets": true,
  "indent_guides": {
    "enabled": true
  },
  "languages": {
    "JavaScript": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": [
        "!tsgo",
        "vtsls",
        "oxlint",
        "oxfmt",
        "biome"
      ]
    },
    "TypeScript": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": [
        "!tsgo",
        "vtsls",
        "oxlint",
        "oxfmt",
        "biome"
      ]
    },
    "TSX": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": [
        "!tsgo",
        "vtsls",
        "oxlint",
        "oxfmt",
        "biome"
      ]
    },
    "JSON": {
      "language_servers": [
        "biome",
        "json-language-server"
      ]
    },
    "JSONC": {
      "language_servers": [
        "biome",
        "json-language-server"
      ]
    }
  }
}
